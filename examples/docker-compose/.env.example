# Copy to .env and replace each value; generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-me
# tenant:key pairs, comma separated; keys at least 32 characters
NOSTRO_API_KEYS=acme:replace-with-openssl-rand-hex-32
NOSTRO_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
NOSTRO_TENANT=acme
NOSTRO_NETWORK=testnet
# The accounts to watch, comma separated; leave empty to serve the API only
NOSTRO_ACCOUNTS=
