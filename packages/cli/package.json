{
  "name": "nostro-cli",
  "version": "0.0.0",
  "private": true,
  "description": "The nostro command line: ingest, reconcile, check and export Stellar payments.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "nostro": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostro-labs/nostro.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "nostro": "workspace:*",
    "nostro-server": "workspace:*",
    "nostro-store-postgres": "workspace:*",
    "nostro-store-sqlite": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "better-sqlite3": "^12.11.1",
    "nostro-testkit": "workspace:*",
    "pg": "^8.13.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
